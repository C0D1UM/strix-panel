# SITE_ADDRESS defaults to plain HTTP on :80. Set it to your domain (e.g. panel.example.com)
# and publish ports 80/443 to get automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
