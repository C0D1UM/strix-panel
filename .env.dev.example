# Local development settings: `cp .env.dev.example .env` on a dev machine (a server uses .env.example instead).
# Optional: every variable below has a working default, so `bun run dev` runs with no .env at all.
# Uncomment only what you want to change. Variables set in the shell win over the file.

# --- Ports ---
# Give each worktree its own ports to run them side by side; DATABASE_URL, BETTER_AUTH_URL and the
# test databases follow them.
# DB_PORT=5432
# API_PORT=3000
# WEB_PORT=5173
# WORKER_HEALTH_PORT=3001

# --- Database ---
# Default: postgres://strix:strix@localhost:<DB_PORT>/strix_panel
# DATABASE_URL=postgres://strix:strix@localhost:5432/strix_panel
# Tests use their own databases (created automatically on the dev Postgres). Base URL if elsewhere:
# TEST_DATABASE_URL=postgres://strix:strix@localhost:5432/strix_panel_test

# --- Auth (Better Auth) ---
# Default: http://localhost:<WEB_PORT>
# BETTER_AUTH_URL=http://localhost:5173
# Default: a fixed, insecure dev secret.
# BETTER_AUTH_SECRET=
# Default in dev: email + password on, Google off.
# AUTH_EMAIL_PASSWORD_ENABLED=true
# AUTH_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# false blocks new accounts (existing users still sign in; `bun run db:seed` still works).
# AUTH_REGISTRATION_ENABLED=true
# false holds new accounts for admin approval before they can start scans.
# AUTH_AUTO_APPROVE_USERS=true
# ALLOWED_EMAIL_DOMAINS=
# Local admin created by `bun run db:seed`
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=P@ssw0rd
# SEED_ADMIN_NAME=Admin

# --- Worker / Strix ---
# Needed to run real scans. See https://docs.strix.ai/llm-providers/overview
# STRIX_LLM=anthropic/claude-sonnet-5
# LLM_API_KEY=
# WORKER_CONCURRENCY=1
# Strix executable. Default: `strix` on PATH.
# STRIX_BIN=strix
# Each scan runs in its own folder below this one.
# STRIX_WORK_DIR=strix_runs
# How often the worker reads a running scan's files, in milliseconds.
# STRIX_POLL_INTERVAL_MS=2000
# Python of the Strix install, for PDF reports (Strix's own renderer). Empty = PDF reports off. With a
# `uv tool install strix-agent`: ~/.local/share/uv/tools/strix-agent/bin/python
# STRIX_PYTHON=
# Rendered PDFs, shared by the API and the worker. Default: <system temp dir>/strix-panel-reports
# REPORT_DIR=
