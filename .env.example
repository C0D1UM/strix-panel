# Optional for local development: every variable below has a working default, so `bun run dev`
# runs with no .env at all. Copy to .env and uncomment only what you want to change.
# Production (NODE_ENV=production, as in the Docker images) requires DATABASE_URL, BETTER_AUTH_URL
# and BETTER_AUTH_SECRET, and defaults to Google sign-in on and email + password off.

# --- Database ---
# Host port for the dev Postgres (`bun run dev:infra`). Give each worktree its own to run them side by side;
# the default DATABASE_URL and test databases follow it.
# DB_PORT=5432
# Default: postgres://strix:strix@localhost:<DB_PORT>/strix_panel
# DATABASE_URL=postgres://strix:strix@localhost:5432/strix_panel
# Tests use their own databases (created automatically on the dev Postgres). Base URL if elsewhere:
# TEST_DATABASE_URL=postgres://strix:strix@localhost:5432/strix_panel_test
# Compose credentials (compose.yaml builds its own DATABASE_URL from these):
# POSTGRES_USER=strix
# POSTGRES_PASSWORD=strix
# POSTGRES_DB=strix_panel

# --- Auth (Better Auth) ---
# Public URL the browser uses. Default in dev: http://localhost:<WEB_PORT>. Compose: http://localhost:8080
# BETTER_AUTH_URL=http://localhost:5173
# Default in dev: a fixed, insecure dev secret. Required for compose. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Google OAuth. Default: off in dev, on in production. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# AUTH_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email + password sign-in. Default: on in dev, off in production.
# AUTH_EMAIL_PASSWORD_ENABLED=true
# Comma-separated domains allowed to sign in. Empty = anyone. The first user to sign in becomes admin.
# ALLOWED_EMAIL_DOMAINS=
# Local admin created by `bun run db:seed` (refuses to run when NODE_ENV=production)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=P@ssw0rd
# SEED_ADMIN_NAME=Admin

# --- Ports ---
# API_PORT=3000
# WEB_PORT=5173
# Host port for Caddy in compose.yaml
# PANEL_PORT=8080
# Caddy site address. Set to your domain for automatic HTTPS (and publish 80/443).
# SITE_ADDRESS=:80

# --- Worker / Strix ---
# WORKER_HEALTH_PORT=3001
# WORKER_CONCURRENCY=1
# LLM used by Strix, e.g. openai/gpt-5 or anthropic/claude-sonnet-5
# STRIX_LLM=
# LLM_API_KEY=
# Strix executable. Default: `strix` on PATH (the worker image installs it).
# STRIX_BIN=strix
# Each scan runs in its own folder below this one (compose mounts a volume here).
# STRIX_WORK_DIR=strix_runs
# How often the worker reads a running scan's files, in milliseconds.
# STRIX_POLL_INTERVAL_MS=2000
