# Production settings for compose.yaml: `cp .env.example .env` on the server; Compose reads it automatically.
# Only the variables below are passed to the containers. A dev machine uses .env.dev.example instead.

# --- Required ---
# Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# LLM used by Strix, see https://docs.strix.ai/llm-providers/overview
# STRIX_LLM=anthropic/claude-sonnet-5
# LLM_API_KEY=

# --- Images ---
# Release of the ghcr.io/c0d1um/strix-panel-* images to run, e.g. 0.1.0. Default: latest.
# STRIX_PANEL_VERSION=latest

# --- Web ---
# Public URL people open the panel at. Default: http://localhost:8080
# BETTER_AUTH_URL=https://panel.example.com
# Host port Caddy listens on. Default: 8080
# PANEL_PORT=8080
# Caddy site address. Set to your domain for automatic HTTPS (and publish 80/443).
# SITE_ADDRESS=:80

# --- Sign-in ---
# Email + password sign-in. Default: on.
# AUTH_EMAIL_PASSWORD_ENABLED=true
# Google OAuth. Default: off. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# AUTH_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Set to false to stop new accounts (email sign-up and first-time Google sign-in). Existing users can
# still sign in. Applies even to the very first user, so create the admin first. Default: true.
# AUTH_REGISTRATION_ENABLED=true
# Set to false to hold new accounts for approval: they can sign in and look around, but cannot start scans until
# an admin approves them on the Users page. Only affects new sign-ups. The first user (admin) is always approved.
# Default: true.
# AUTH_AUTO_APPROVE_USERS=true
# Comma-separated domains allowed to sign in. Empty = anyone. The first user to sign in becomes admin.
# ALLOWED_EMAIL_DOMAINS=

# --- Database ---
# Credentials of the bundled Postgres. Set them before the first start: changing them later doesn't
# change the existing database.
# POSTGRES_USER=strix
# POSTGRES_PASSWORD=strix
# POSTGRES_DB=strix_panel
