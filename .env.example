# Copy to .env. Used by `bun run dev` (apps on host) and by docker compose.

# --- Database ---
# Dev (apps on host, infra from compose.dev.yaml):
DATABASE_URL=postgres://strix:strix@localhost:5432/strix_panel
# Tests use their own database (created automatically). Override if your Postgres is elsewhere:
# TEST_DATABASE_URL=postgres://strix:strix@localhost:5432/strix_panel_test
# Compose credentials (compose.yaml builds its own DATABASE_URL from these):
# POSTGRES_USER=strix
# POSTGRES_PASSWORD=strix
# POSTGRES_DB=strix_panel

# --- Auth (Better Auth) ---
# Public URL the browser uses. Dev: Vite (5173). Compose: Caddy (8080).
BETTER_AUTH_URL=http://localhost:5173
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# This file is set up for local development: email + password on, Google off.
# For a real deployment, turn Google on and email + password off.
# Google OAuth — redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email + password sign-in
AUTH_EMAIL_PASSWORD_ENABLED=true
# Comma-separated domains allowed to sign in. Empty = anyone. The first user to sign in becomes admin.
ALLOWED_EMAIL_DOMAINS=
# Local admin created by `bun run db:seed` (refuses to run when NODE_ENV=production)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=P@ssw0rd
SEED_ADMIN_NAME=Admin

# --- Ports ---
API_PORT=3000
WEB_PORT=5173
# Host port for Caddy in compose.yaml
PANEL_PORT=8080
# Caddy site address. Set to your domain for automatic HTTPS (and publish 80/443).
# SITE_ADDRESS=:80

# --- Worker / Strix ---
WORKER_HEALTH_PORT=3001
WORKER_CONCURRENCY=1
# LLM used by Strix, e.g. openai/gpt-5 or anthropic/claude-sonnet-5
STRIX_LLM=
LLM_API_KEY=
